import AjaxRequest from '@typo3/core/ajax/ajax-request.js';

// Sucht nach Duppleten

class NameCheck {
  constructor() {
    this.input = null;
    this.messageBox = null;
    this.saveButtons = [];
    this.timer = null;
    this.lastRequestId = 0;
    this.blocked = false;
  }

  init() {
    this.input = document.querySelector('[data-name-check="1"]');

    if (!this.input) {
      return;
    }

    this.messageBox = document.querySelector('[data-name-check-message="1"]');

    this.saveButtons = Array.from(
      document.querySelectorAll('[data-save-button="1"], button[type="submit"], input[type="submit"]')
    );

    const form = this.input.closest('form');

    this.input.addEventListener('input', () => {
      this.scheduleCheck();
    });

    if (form) {
      form.addEventListener('submit', (event) => {
        if (this.blocked) {
          event.preventDefault();
          event.stopPropagation();
          this.showMessage('Der Datensatz kann nicht gespeichert werden, weil der Name bereits vorhanden ist.', true);
        }
      });
    }

    // Initial prüfen, falls beim Bearbeiten schon ein Wert vorhanden ist
    if (this.input.value.trim() !== '') {
      this.scheduleCheck();
    }
  }

  scheduleCheck() {
    window.clearTimeout(this.timer);

    this.timer = window.setTimeout(() => {
      this.checkName();
    }, 350);
  }

  async checkName() {
    const name = this.input.value.trim();
    const uid = this.input.dataset.uid || '0';

    if (name.length < 2) {
      this.setBlocked(true);
      this.showMessage('Bitte mindestens 2 Zeichen eingeben.', true);
      return;
    }

    const requestId = ++this.lastRequestId;

    try {
      const response = await new AjaxRequest(TYPO3.settings.ajaxUrls.extensionbuilder_checkName)
        .withQueryArguments({
          name: name,
          uid: uid
        })
        .get();

      const result = await response.resolve();

      // Alte Antwort ignorieren, wenn inzwischen weitergetippt wurde
      if (requestId !== this.lastRequestId) {
        return;
      }

      if (result.exists === true || result.valid === false) {
        this.setBlocked(true);
        this.showMessage(result.message || 'Dieser Name ist bereits vorhanden.', true);
        return;
      }

      this.setBlocked(false);
      this.showMessage(result.message || 'Name ist verfügbar.', false);
    } catch (error) {
      this.setBlocked(true);
      this.showMessage('Die Namensprüfung konnte nicht durchgeführt werden. Speichern wurde vorsorglich gesperrt.', true);
    }
  }

  setBlocked(blocked) {
    this.blocked = blocked;

    this.input.classList.toggle('is-invalid', blocked);
    this.input.classList.toggle('is-valid', !blocked);

    this.input.setCustomValidity(
      blocked ? 'Dieser Name ist nicht zulässig.' : ''
    );

    this.saveButtons.forEach((button) => {
      button.disabled = blocked;
      button.classList.toggle('disabled', blocked);
    });
  }

  showMessage(message, isError) {
    if (!this.messageBox) {
      return;
    }

    this.messageBox.textContent = message;
    this.messageBox.classList.toggle('text-danger', isError);
    this.messageBox.classList.toggle('text-success', !isError);
  }
}

document.addEventListener('DOMContentLoaded', () => {
  new NameCheck().init();
});