{
    "name": "extensionbuilder/extensionbuilder-typo3",
    "type": "typo3-cms-extension",
    "description": "The Extension Builder for TYPO3, supporting version 12 and above",
	"homepage": "https://extension-builder.dev",
    "license": ["GPL-2.0-or-later"],
    "authors": [{
        "name": "Stephan Franz Sellner",
        "email": "contact@extension-builder.dev",
        "homepage": "https://extension-builder.dev",
        "role": "Developer"
    }],
    "support": {
        "docs": "https://extension-builder.dev/documentation/extensionbuilder-typo3",
        "source": "https://github.com/ExtensionBuilder/extensionbuilder-typo3",
        "issues": "https://github.com/ExtensionBuilder/extensionbuilder-typo3/issues"
    },
    "require": {
        "typo3/cms-core": "^12.4 || ^13.4 || ^14.3"
    },
    "extra": {
        "typo3/cms": { "extension-key": "extensionbuilder_typo3" }
    },
    "autoload": {
        "psr-4": {
              "ExtensionBuilder\\ExtensionbuilderTypo3\\": "Classes/"
        }
    }
}
